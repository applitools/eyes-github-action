{
  "name": "applitools-visual-review-action",
  "version": "0.1.0",
  "private": true,
  "description": "Applitools Eyes visual review gate for pull requests: Visual tests and Design review checks.",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "ncc build src/index.ts -o dist --license licenses.txt",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "all": "npm run typecheck && npm test && npm run build"
  },
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/exec": "^3.0.0",
    "@actions/github": "^9.1.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@vercel/ncc": "^0.45.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12",
    "yaml": "^2.9.1"
  }
}
